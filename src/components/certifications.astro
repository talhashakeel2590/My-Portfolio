---
const certifications = [
  {
    title: "Java Programming",
    issuer: "NED University of Engineering & Technology",
    status: "Certified",
    link: null 
  },
  {
    title: "Java Programming: Principles of Software Design",
    issuer: "Coursera / Duke University",
    status: "Certified",
    link: "https://coursera.org/share/c8eceeafb81b53a89c1b93dfcf474367" 
  },
  {
    title: "Java Programming: Arrays, Lists, and Structured Data",
    issuer: "Coursera / Duke University",
    status: "Certified",
    link: "https://coursera.org/share/5d446816422d14ed8a31353d2616def4" 
  },
  {
    title: "AWS Cloud Essentials",
    issuer: "Amazon Web Services",
    status: "Learning",
    link: null 
  }
];
---

<section id="certifications" class="py-12 border-t border-[#ffffff10] text-[var(--white)]">
  <div class="max-w-5xl mx-auto px-6 md:px-0">
    <h2 class="text-lg text-[var(--sec)] mb-2 shiny-sec">Credentials</h2>
    <h3 class="text-4xl md:text-5xl font-medium mb-8">Certifications</h3>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      {
        certifications.map((cert) => {
          const CardWrapper = cert.link ? 'a' : 'div';
          return (
            <CardWrapper 
              href={cert.link || undefined}
              target={cert.link ? "_blank" : undefined}
              rel={cert.link ? "noopener noreferrer" : undefined}
              class={`project-card group flex flex-col p-6 bg-[#1414149c] border border-[#ffffff10] rounded-2xl transition-colors duration-300 ${cert.link ? 'hover:border-[var(--sec)] cursor-pointer' : ''}`}
            >
              <div class="flex items-center justify-between mb-4">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-[var(--sec)] size-8"><circle cx="12" cy="8" r="6"/><path d="M15.477 12.89 17 22l-5-3-5 3 1.523-9.11"/></svg>
                
                <span class={`text-xs font-bold px-3 py-1 rounded-full ${cert.status === "Certified" ? "bg-green-500/20 text-green-400" : "bg-blue-500/20 text-blue-400"}`}>
                  {cert.status}
                </span>
              </div>
              
              <h4 class="text-lg font-semibold mb-2 group-hover:text-[var(--sec)] transition-colors leading-tight">
                {cert.title}
              </h4>
              <p class="text-sm text-[var(--white-icon)] mt-auto">{cert.issuer}</p>
              
              {cert.link && (
                <div class="mt-4 flex items-center text-xs text-[var(--sec)] font-medium">
                  <span>Verify Credential</span>
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-4 ml-1"><path d="M16.0037 9.41421L7.39712 18.0208L5.98291 16.6066L14.5895 8H7.00373V6H18.0037V17H16.0037V9.41421Z"></path></svg>
                </div>
              )}
            </CardWrapper>
          );
        })
      }
    </div>
  </div>
</section>