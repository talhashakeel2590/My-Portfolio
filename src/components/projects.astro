---
interface Project {
  title: string;
  image: string;
  link: string;
  preview: string;
  status: string;
  description: string;
}

const projects: Project[] = [
  // ... your projects array stays exactly the same ...
  {
    title: "Smart Gas Safety System (FYP)",
    image: "https://placehold.co/600x400/1a1a1a/ffffff?text=Smart+Gas+Safety+System",
    link: "https://github.com/talhashakeel2590",
    preview: "https://github.com/talhashakeel2590",
    status: "ESP32 • Spring Boot • Java",
    description: "IoT hardware prototype with a Spring Boot backend. Features an offline-safe safety loop, Edge AI risk scoring, and real-time Firebase/OneSignal alerts to automatically shut off gas valves."
  },
  {
    title: "School Fee & Payment System",
    image: "https://placehold.co/600x400/1a1a1a/ffffff?text=Fee+Management+System",
    link: "https://github.com/talhashakeel2590/Project--school-fee-management-",
    preview: "https://github.com/talhashakeel2590/Project--school-fee-management-",
    status: "PHP • SQL Server",
    description: "Full-stack web app with session-based authentication and role-based access control. Auto-generates class fees, dynamically calculates outstanding balances, and uses parameterized queries to prevent SQL injection."
  },
  {
    title: "Vigenere Cipher Breaker",
    image: "https://placehold.co/600x400/1a1a1a/ffffff?text=Vigenere+Cipher+Breaker",
    link: "https://github.com/talhashakeel2590/Vigenere-Cipher",
    preview: "https://github.com/talhashakeel2590/Vigenere-Cipher",
    status: "Java • Algorithms",
    description: "A Java tool that recovers a cipher key of unknown length using letter-frequency analysis, extending it to auto-detect the message's language across 8 dictionaries."
  },
  {
    title: "Apache WebLog Parser",
    image: "https://placehold.co/600x400/1a1a1a/ffffff?text=Apache+WebLog+Parser",
    link: "https://github.com/talhashakeel2590/Weblog-Analyzer",
    preview: "https://github.com/talhashakeel2590/Weblog-Analyzer",
    status: "Java • Data Parsing",
    description: "Parses raw Apache-style server logs into structured records. Built aggregation logic to identify unique visitor IPs, filter by HTTP status codes, and find peak-traffic days."
  }
];
---

<section id="projects" class="py-10 md:py-12 border-t border-[#ffffff10] text-[var(--white)] relative w-full overflow-hidden">
  <div class="max-w-4xl mx-auto px-5 md:px-0">
    <h2 class="text-lg text-[var(--sec)] mb-2 shiny-sec">My work</h2>
    <h3 class="scramble-text text-3xl md:text-5xl font-medium mb-8">Projects</h3>

    <div class="flex flex-col gap-6 md:gap-12 pb-8 md:pb-32">
      {
        projects.map((project, index) => (
          <div class="sticky-card" style={`--index: ${index};`}>
            <!-- Tilt wrapper is ignored on mobile via CSS -->
            <div class="md:tilt-wrapper">
              <div class="project-card group flex flex-col h-full bg-[#1414149c] border border-[#ffffff20] rounded-2xl md:rounded-3xl overflow-hidden shadow-[0_10px_30px_rgba(0,0,0,0.5)] md:shadow-[0_20px_50px_rgba(0,0,0,0.9)] transition-colors duration-300 hover:border-[var(--sec)]">
                
                <div data-tilt-child class="w-full">
                  <a href={project.preview} target="_blank" rel="noopener noreferrer" class="block overflow-hidden">
                    <img src={project.image} alt={project.title} class="w-full h-48 md:h-80 object-cover group-hover:scale-105 transition-transform duration-300" />
                  </a>
                </div>

                <div class="p-5 md:p-8 flex flex-col flex-grow" style="transform: translateZ(0);">
                  <div class="flex items-start justify-between mb-3">
                    <div>
                      <h4 class="text-xl md:text-3xl font-semibold">{project.title}</h4>
                      <span class="text-xs md:text-base text-[var(--sec)] font-medium tracking-wide mt-1 block">{project.status}</span>
                    </div>
                    <div class="flex gap-2 ml-auto">
                      <a target="_blank" href={project.link} aria-label="GitHub" class="flex justify-center items-center text-[var(--white-icon)] hover:text-white transition duration-300 ease-in-out border border-1 border-[var(--white-icon-tr)] p-2 md:p-3 rounded-lg md:rounded-xl bg-[#1414149c] hover:bg-[var(--white-icon-tr)]">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-5 md:size-7"><path d="M12.001 2C6.47598 2 2.00098 6.475 2.00098 12C2.00098 16.425 4.86348 20.1625 8.83848 21.4875C9.33848 21.575 9.52598 21.275 9.52598 21.0125C9.52598 20.775 9.51348 19.9875 9.51348 19.15C7.00098 19.6125 6.35098 18.5375 6.15098 17.975C6.03848 17.6875 5.55098 16.8 5.12598 16.5625C4.77598 16.375 4.27598 15.9125 5.11348 15.9C5.90098 15.8875 6.46348 16.625 6.65098 16.925C7.55098 18.4375 8.98848 18.0125 9.56348 17.75C9.65098 17.1 9.91348 16.6625 10.201 16.4125C7.97598 16.1625 5.65098 15.3 5.65098 11.475C5.65098 10.3875 6.03848 9.4875 6.67598 8.7875C6.57598 8.5375 6.22598 7.5125 6.77598 6.1375C6.77598 6.1375 7.61348 5.875 9.52598 7.1625C10.326 6.9375 11.176 6.825 12.026 6.825C12.876 6.825 13.726 6.9375 14.526 7.1625C16.4385 5.8625 17.276 6.1375 17.276 6.1375C17.826 7.5125 17.476 8.5375 17.376 8.7875C18.0135 9.4875 18.401 10.375 18.401 11.475C18.401 15.3125 16.0635 16.1625 13.8385 16.4125C14.201 16.725 14.5135 17.325 14.5135 18.2625C14.5135 19.6 14.501 20.675 14.501 21.0125C14.501 21.275 14.6885 21.5875 15.1885 21.4875C19.259 20.1133 21.9999 16.2963 22.001 12C22.001 6.475 17.526 2 12.001 2Z"></path></svg>
                      </a>
                    </div>
                  </div>
                  <p class="text-[var(--white-icon)] text-sm md:text-base leading-relaxed">{project.description}</p>
                </div>
              </div>
            </div>
          </div>
        ))
      }
    </div>
    
    <a target="_blank" href="https://github.com/talhashakeel2590" aria-label="GitHub" class="magnetic-button w-full flex items-center justify-center gap-2 mt-0 md:mt-9 text-[var(--white-icon)] hover:text-white border border-[var(--white-icon-tr)] p-3 md:p-4 rounded-full bg-[#1414149c] hover:bg-[var(--white-icon-tr)] relative z-20">
      <span class="text-base md:text-lg">More projects on</span>
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-5 md:size-6"><path d="M12.001 2C6.47598 2 2.00098 6.475 2.00098 12C2.00098 16.425 4.86348 20.1625 8.83848 21.4875C9.33848 21.575 9.52598 21.275 9.52598 21.0125C9.52598 20.775 9.51348 19.9875 9.51348 19.15C7.00098 19.6125 6.35098 18.5375 6.15098 17.975C6.03848 17.6875 5.55098 16.8 5.12598 16.5625C4.77598 16.375 4.27598 15.9125 5.11348 15.9C5.90098 15.8875 6.46348 16.625 6.65098 16.925C7.55098 18.4375 8.98848 18.0125 9.56348 17.75C9.65098 17.1 9.91348 16.6625 10.201 16.4125C7.97598 16.1625 5.65098 15.3 5.65098 11.475C5.65098 10.3875 6.03848 9.4875 6.67598 8.7875C6.57598 8.5375 6.22598 7.5125 6.77598 6.1375C6.77598 6.1375 7.61348 5.875 9.52598 7.1625C10.326 6.9375 11.176 6.825 12.026 6.825C12.876 6.825 13.726 6.9375 14.526 7.1625C16.4385 5.8625 17.276 6.1375 17.276 6.1375C17.826 7.5125 17.476 8.5375 17.376 8.7875C18.0135 9.4875 18.401 10.375 18.401 11.475C18.401 15.3125 16.0635 16.1625 13.8385 16.4125C14.201 16.725 14.5135 17.325 14.5135 18.2625C14.5135 19.6 14.501 20.675 14.501 21.0125C14.501 21.275 14.6885 21.5875 15.1885 21.4875C19.259 20.1133 21.9999 16.2963 22.001 12C22.001 6.475 17.526 2 12.001 2Z"></path></svg>
    </a>
  </div>
</section>